{
  "name": "moneytraildash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:unit && npm run test:macro",
    "test:unit": "node -r tsx/cjs tests/evidence-review.test.ts && node -r tsx/cjs tests/portfolio-exposure.test.ts && node -r tsx/cjs tests/ticker-aggregate.test.ts && node -r tsx/cjs tests/chart-range.test.ts && node -r tsx/cjs tests/price-feed.test.ts",
    "test:macro": "node --test lib/macro-read-model.test.mjs",
    "release:check-preview": "node ops/release/check-preview-environment.mjs",
    "release:test": "python3 -m unittest discover -s ops/release/tests -p 'test_*.py' && node ops/release/tests/check-preview-environment.test.mjs"
  },
  "dependencies": {
    "@next/font": "^14.2.15",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "geist": "^1.7.0",
    "lightweight-charts": "^5.2.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
